@{
    Layout = null;
}
<!doctype html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f2eb">
    <title>میز خدمت حمایتی | علیپور</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <script src="/js/dashboard.js" defer></script>
</head>
<body>
    <div class="app-shell">
        <aside class="side-rail" aria-label="پیمایش اصلی">
            <a class="brand" href="/" aria-label="میز خدمت حمایتی، صفحه اصلی">
                <span class="brand-mark" aria-hidden="true">م</span>
                <span class="brand-copy"><strong>میز خدمت</strong><small>سامانه حمایت علیپور</small></span>
            </a>
            <span class="rail-caption">کار با پرونده‌ها</span>
            <nav class="primary-nav" aria-label="بخش‌ها">
                <button class="nav-link is-active" type="button" data-view="queue" aria-current="page">
                    <span class="nav-symbol" aria-hidden="true">▤</span><span>صف اولویت</span>
                </button>
                <button class="nav-link" type="button" data-view="reports">
                    <span class="nav-symbol" aria-hidden="true">▥</span><span>گزارش درخواست‌ها</span>
                </button>
            </nav>
            <div class="rail-rule"></div>
            <span class="rail-caption">ثبت اطلاعات</span>
            <button class="rail-action" type="button" data-open="beneficiary-dialog"><span aria-hidden="true">＋</span>ثبت مددجو</button>
            <button class="rail-action" type="button" data-open="request-dialog"><span aria-hidden="true">＋</span>درخواست تازه</button>
            <div class="rail-footer">
                <span class="connection-dot" aria-hidden="true"></span>
                <span><strong>اتصال سامانه</strong><small id="connection-label">در حال بررسی</small></span>
            </div>
        </aside>

        <main class="main-content">
            <header class="page-header">
                <div>
                    <p class="eyebrow">خدمات حمایتی <span aria-hidden="true">/</span> مدیریت پرونده</p>
                    <h1>صف درخواست‌های حمایتی</h1>
                    <p class="page-lede">درخواست‌ها را بر پایه نیاز و زمان انتظار پیگیری کنید.</p>
                </div>
                <div class="header-actions">
                    <span class="today-date" id="today-date"></span>
                    <button class="button button-quiet mobile-beneficiary-action" type="button" data-open="beneficiary-dialog"><span aria-hidden="true">＋</span> ثبت مددجو</button>
                    <button class="button button-primary" type="button" data-open="request-dialog"><span aria-hidden="true">＋</span> ثبت درخواست</button>
                </div>
            </header>
            <div class="notice" id="notice" role="status" aria-live="polite" hidden></div>

            <section class="view-panel beneficiary-panel" aria-labelledby="beneficiaries-title">
                <div class="section-heading">
                    <div><span class="section-index">۰۱ <i></i> فهرست مددجویان</span><h2 id="beneficiaries-title">مددجویان ثبت‌شده</h2></div>
                </div>
                <form class="filter-bar directory-filter" id="beneficiary-filters">
                    <label class="search-field"><span>جست‌وجوی کد ملی</span><input name="search" type="search" placeholder="کد ملی را وارد کنید…" autocomplete="off"></label>
                    <label class="filter-field page-size-field"><span>تعداد در صفحه</span><select name="pageSize" aria-label="تعداد مددجو در صفحه"><option value="5" selected>۵</option><option value="10">۱۰</option><option value="20">۲۰</option><option value="50">۵۰</option></select></label>
                    <span class="queue-total" id="beneficiary-total" aria-live="polite">در حال دریافت…</span>
                </form>
                <div class="table-wrap" aria-busy="false" id="beneficiary-region">
                    <table class="directory-table">
                        <thead><tr>
                            <th scope="col"><button type="button" class="sort-button is-sorted" data-table-sort="beneficiaries" data-sort-key="nationalId">کد ملی <span aria-hidden="true">↓</span></button></th>
                            <th scope="col"><button type="button" class="sort-button" data-table-sort="beneficiaries" data-sort-key="age">سن <span aria-hidden="true">↕</span></button></th>
                            <th scope="col">وضعیت تأهل</th>
                            <th scope="col"><button type="button" class="sort-button" data-table-sort="beneficiaries" data-sort-key="dependents">تحت تکفل <span aria-hidden="true">↕</span></button></th>
                            <th scope="col">نوع معلولیت</th>
                            <th scope="col"><button type="button" class="sort-button" data-table-sort="beneficiaries" data-sort-key="income">درآمد ماهانه <span aria-hidden="true">↕</span></button></th>
                            <th scope="col">اقدام</th>
                        </tr></thead>
                        <tbody id="beneficiary-body"><tr><td colspan="6"><div class="table-state"><span class="spinner" aria-hidden="true"></span>در حال بارگذاری مددجویان…</div></td></tr></tbody>
                    </table>
                </div>
                <div class="table-footer"><span id="beneficiary-page-caption">صفحه ۱</span><div class="pagination" aria-label="صفحه‌بندی مددجویان"><button class="page-button" id="beneficiary-previous" type="button" aria-label="مددجویان صفحه قبل" disabled>‹</button><span id="beneficiary-page-number" dir="ltr">1</span><button class="page-button" id="beneficiary-next" type="button" aria-label="مددجویان صفحه بعد" disabled>›</button></div></div>
            </section>

            <section class="view-panel" id="queue-view" aria-labelledby="queue-title">
                <div class="section-heading">
                    <div><span class="section-index">۰۲ <i></i> اولویت‌بندی</span><h2 id="queue-title">درخواست‌های ثبت‌شده</h2></div>
                    <button class="button button-quiet" type="button" id="refresh-queue"><span aria-hidden="true">↻</span> تازه‌سازی</button>
                </div>
                <form class="filter-bar" id="queue-filters">
                    <label class="filter-field"><span>نوع خدمت</span><select name="serviceType" aria-label="فیلتر بر اساس نوع خدمت"><option value="">همه خدمات</option><option value="Wheelchair">ویلچر</option><option value="HousingDepositLoan">وام ودیعه مسکن</option><option value="Pension">مستمری</option></select></label>
                    <label class="filter-field"><span>وضعیت پرونده</span><select name="status" aria-label="فیلتر بر اساس وضعیت"><option value="">همه وضعیت‌ها</option><option value="Pending">در انتظار بررسی</option><option value="Approved">تأییدشده</option><option value="Rejected">ردشده</option><option value="Completed">تکمیل‌شده</option></select></label>
                    <label class="search-field"><span>جست‌وجوی مددجو یا شرح</span><input name="search" type="search" placeholder="کد ملی یا واژه‌ای از شرح…" autocomplete="off"></label>
                    <label class="filter-field sort-field"><span>مرتب‌سازی</span><select name="sortBy" aria-label="مرتب‌سازی درخواست‌ها"><option value="priority">بیشترین اولویت</option><option value="date">تاریخ ثبت</option><option value="person">کد ملی مددجو</option><option value="service">نوع خدمت</option><option value="status">وضعیت</option></select></label>
                    <label class="filter-field direction-field"><span>جهت</span><select name="sortDirection" aria-label="جهت مرتب‌سازی"><option value="desc">نزولی</option><option value="asc">صعودی</option></select></label>
                    <label class="filter-field page-size-field"><span>تعداد در صفحه</span><select name="pageSize" aria-label="تعداد درخواست در صفحه"><option value="5" selected>۵</option><option value="10">۱۰</option><option value="20">۲۰</option><option value="50">۵۰</option></select></label>
                    <span class="queue-total" id="queue-total" aria-live="polite">در حال دریافت…</span>
                </form>
                <div class="table-wrap" aria-busy="false" id="queue-region">
                    <table class="queue-table">
                        <thead><tr><th scope="col">رتبه</th><th scope="col"><button type="button" class="sort-button" data-table-sort="requests" data-sort-key="priority">امتیاز <span aria-hidden="true">↓</span></button></th><th scope="col"><button type="button" class="sort-button" data-table-sort="requests" data-sort-key="person">مددجو <span aria-hidden="true">↕</span></button></th><th scope="col"><button type="button" class="sort-button" data-table-sort="requests" data-sort-key="service">خدمت درخواستی <span aria-hidden="true">↕</span></button></th><th scope="col"><button type="button" class="sort-button" data-table-sort="requests" data-sort-key="date">تاریخ ثبت <span aria-hidden="true">↕</span></button></th><th scope="col"><button type="button" class="sort-button" data-table-sort="requests" data-sort-key="status">وضعیت <span aria-hidden="true">↕</span></button></th><th scope="col">اقدام</th></tr></thead>
                        <tbody id="queue-body"><tr><td colspan="7"><div class="table-state"><span class="spinner" aria-hidden="true"></span>در حال بارگذاری صف…</div></td></tr></tbody>
                    </table>
                </div>
                <div class="table-footer"><span id="page-caption">صفحه ۱</span><div class="pagination" aria-label="صفحه‌بندی"><button class="page-button" id="previous-page" type="button" aria-label="صفحه قبل" disabled>‹</button><span id="page-number" dir="ltr">1</span><button class="page-button" id="next-page" type="button" aria-label="صفحه بعد" disabled>›</button></div></div>
            </section>

            <section class="view-panel report-panel" id="reports-view" aria-labelledby="reports-title" hidden>
                <div class="section-heading">
                    <div><span class="section-index">۰۲ <i></i> گزارش عملکرد</span><h2 id="reports-title">توزیع درخواست‌ها</h2></div>
                    <button class="button button-quiet" type="button" id="refresh-reports"><span aria-hidden="true">↻</span> تازه‌سازی</button>
                </div>
                <p class="report-intro">شمار درخواست‌ها به تفکیک نوع خدمت و وضعیت جاری.</p>
                <section class="statistics-chart" aria-labelledby="status-chart-title">
                    <div class="chart-heading"><h3 id="status-chart-title">تعداد پرونده‌ها بر اساس وضعیت</h3><span>نمای کلی همه درخواست‌ها</span></div>
                    <div id="status-chart" class="status-chart" role="img" aria-label="نمودار میله‌ای تعداد درخواست‌ها بر اساس وضعیت">
                        <div class="chart-state"><span class="spinner" aria-hidden="true"></span>در حال بارگذاری نمودار…</div>
                    </div>
                </section>
                <div class="section-heading statistics-table-heading">
                    <div><span class="section-index">جزئیات <i></i> آمار تجمیعی</span><h3 id="report-breakdown-title">خدمت به تفکیک وضعیت</h3></div>
                    <button class="button button-quiet" type="button" id="clear-report-drilldown" hidden>نمایش همه وضعیت‌ها</button>
                </div>
                <div class="report-table-wrap"><table class="report-table">
                    <thead><tr><th scope="col">نوع خدمت</th><th scope="col">در انتظار</th><th scope="col">تأییدشده</th><th scope="col">ردشده</th><th scope="col">تکمیل‌شده</th><th scope="col">جمع خدمت</th></tr></thead>
                    <tbody id="report-body"><tr><td colspan="6"><div class="table-state"><span class="spinner" aria-hidden="true"></span>در حال بارگذاری گزارش…</div></td></tr></tbody><tfoot id="report-foot"></tfoot>
                </table></div>
                <p class="report-source">منبع داده: سامانه ثبت درخواست‌ها</p>
            </section>
            <footer class="page-footer"><span>سامانه خدمات حمایتی علیپور</span><span>اطلاعات بر اساس آخرین ثبت سامانه</span></footer>
        </main>
    </div>

    <dialog class="form-dialog" id="beneficiary-dialog" aria-labelledby="beneficiary-dialog-title">
        <form id="beneficiary-form" novalidate>
            <input type="hidden" name="id" value="">
            <div class="dialog-header"><div><span class="section-index">ثبت اطلاعات پایه</span><h2 id="beneficiary-dialog-title">ثبت مددجو</h2></div><button class="icon-button" type="button" data-close aria-label="بستن فرم">×</button></div>
            <p class="dialog-intro">مشخصات را مطابق مدارک هویتی وارد کنید.</p>
            <div class="form-grid">
                <label class="form-field"><span>کد ملی <b>*</b></span><input name="nationalId" type="text" inputmode="numeric" autocomplete="off" placeholder="۱۰ رقم" pattern="[0-9۰-۹٠-٩]{10}" maxlength="10" required dir="ltr"><small>کد ملی باید ۱۰ رقم باشد.</small></label>
                <label class="form-field"><span>سن <b>*</b></span><input name="age" type="number" min="0" max="120" required placeholder="مثلاً ۶۸"></label>
                <label class="form-field"><span>وضعیت تأهل <b>*</b></span><select name="maritalStatus" required><option value="">انتخاب کنید</option><option value="Single">مجرد</option><option value="Married">متأهل</option><option value="Divorced">مطلقه</option><option value="Widowed">همسر فوت‌شده</option></select></label>
                <label class="form-field"><span>تعداد افراد تحت تکفل <b>*</b></span><input name="dependentCount" type="number" min="0" max="50" required placeholder="۰"></label>
                <label class="form-field"><span>نوع معلولیت <b>*</b></span><select name="disabilityType" required><option value="">انتخاب کنید</option><option value="None">ندارد</option><option value="Mild">خفیف</option><option value="Moderate">متوسط</option><option value="Severe">شدید</option></select></label>
                <label class="form-field"><span>درآمد ماهانه (تومان) <b>*</b></span><input name="monthlyIncome" type="number" min="0" step="any" required placeholder="۰"></label>
            </div>
            <p class="form-error" data-form-error role="alert" hidden></p>
            <div class="dialog-actions"><button class="button button-quiet" type="button" data-close>انصراف</button><button class="button button-primary" type="submit" data-beneficiary-submit>ثبت مددجو</button></div>
        </form>
    </dialog>

    <dialog class="form-dialog" id="request-dialog" aria-labelledby="request-dialog-title">
        <form id="request-form" novalidate>
            <div class="dialog-header"><div><span class="section-index">ایجاد پرونده جدید</span><h2 id="request-dialog-title">ثبت درخواست خدمت</h2></div><button class="icon-button" type="button" data-close aria-label="بستن فرم">×</button></div>
            <p class="dialog-intro">درخواست به صف اولویت‌بندی اضافه می‌شود.</p>
            <div class="form-grid form-grid-single">
                <label class="form-field"><span>مددجو <b>*</b></span><select name="beneficiaryId" required><option value="">در حال دریافت فهرست…</option></select><small data-beneficiary-hint></small></label>
                <label class="form-field"><span>نوع خدمت <b>*</b></span><select name="serviceType" required><option value="">انتخاب خدمت</option><option value="Wheelchair">ویلچر</option><option value="HousingDepositLoan">وام ودیعه مسکن</option><option value="Pension">مستمری</option></select></label>
                <label class="form-field"><span>شرح نیاز <b>*</b></span><textarea name="description" rows="4" maxlength="1000" required placeholder="شرح کوتاهی از نیاز مددجو بنویسید…"></textarea><small>حداکثر ۱۰۰۰ نویسه</small></label>
            </div>
            <p class="form-error" data-form-error role="alert" hidden></p>
            <div class="dialog-actions"><button class="button button-quiet" type="button" data-close>انصراف</button><button class="button button-primary" type="submit">ثبت در صف</button></div>
        </form>
    </dialog>
</body>
</html>